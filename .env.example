# Video generation: https://replicate.com/account/api-tokens
# Empty = demo mode (fake generations with sample clips).
REPLICATE_API_TOKEN=

# Payments: https://dashboard.stripe.com/test/apikeys (use sk_test_ while developing)
# Empty = test mode (buying a pack adds credits without payment; disabled in production).
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`, or the dashboard webhook page.
STRIPE_WEBHOOK_SECRET=

# Public URL used for Stripe redirect links, e.g. https://clipforge.example.com
APP_URL=http://localhost:3000

# Database. Set a Postgres URL (Neon, Supabase) when hosting on Vercel.
# Empty = local SQLite file at ./data/app.db (or DATABASE_PATH).
DATABASE_URL=
# DATABASE_PATH=
